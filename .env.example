# Copy to .env and fill in ONE of the following. .env is gitignored.
# Gemini free tier is sufficient for the full starter corpus:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternatives (the provider is selected by FACTLAYER_LLM):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides
# FACTLAYER_LLM=gemini          # gemini | openai | anthropic | replay
# FACTLAYER_MODEL=gemini-2.5-flash
